<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* YOLOv8-seg 实例分割示例</c>
<c>* 模型文件位于工程根目录: best.xml</c>
<c></c>
<l>ModelPath := './best.xml'</l>
<l>Device := 'CPU'</l>
<c></c>
<c>* 加载模型 (字符串值用set_dict_tuple, 对象用set_dict_object)</c>
<l>create_dict (ModelDict)</l>
<l>set_dict_tuple (ModelDict, '工程路径', ModelPath)</l>
<l>set_dict_tuple (ModelDict, '使用设备', Device)</l>
<l>OpenvinoLoadModel (ModelDict, ModelHandle)</l>
<c></c>
<c>* 读取测试图像</c>
<l>read_image (Image, 'D:/Desktop/AIProjectTemp/yolo26s_delivery/dataset/images/val/33_r2c1.png')</l>
<l>get_image_size (Image, Width, Height)</l>
<c></c>
<c>* 执行检测</c>
<l>create_dict (InferDict)</l>
<l>set_dict_object (Image, InferDict, 'InputImage')</l>
<l>set_dict_tuple (InferDict, 'ConfThreshold', 0.25)</l>
<l>set_dict_tuple (InferDict, 'MaskThreshold', 0.5)</l>
<l>yolo_seg_detect (ModelHandle, InferDict)</l>
<c></c>
<c>* 获取结果</c>
<c>* get_dict_tuple( : : DictHandle, Key : Value)</c>
<c>* get_dict_object( : : DictHandle, Key : Object)</c>
<l>get_dict_tuple (InferDict, 'NumDetections', NumDets)</l>
<l>get_dict_object (BoundingBoxes, InferDict, 'BoundingBoxes')</l>
<l>get_dict_object (ClassLabelImage, InferDict, 'ClassLabelImage')</l>
<l>threshold (ClassLabelImage, Regions, 1, 65535)</l>
<c></c>
<l>get_dict_tuple (InferDict, 'Confidences', Confs)</l>
<l>get_dict_tuple (InferDict, 'ClassIDs', ClassIDs)</l>
<c></c>
<c>* 显示结果</c>
<l>dev_open_window (0, 0, Width, Height, 'black', WindowHandle)</l>
<l>* set_display_font (WindowHandle, 14, 'mono', 'true', 'false')</l>
<c></c>
<c>* 显示类别标签图 (像素灰度值 = 类别ID)</c>
<l>dev_display (ClassLabelImage)</l>
<c></c>
<c>* 叠加显示识别框和置信度</c>
<l>dev_set_color ('green')</l>
<l>dev_set_line_width (2)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_display (BoundingBoxes)</l>
<c></c>
<c>* 显示每个检测的置信度</c>
<l>for Index := 1 to NumDets by 1</l>
<l>    select_obj (BoundingBoxes, SingleRect, Index)</l>
<l>    smallest_rectangle1 (SingleRect, Row1, Col1, Row2, Col2)</l>
<l>    Conf := Confs[Index - 1]</l>
<l>    disp_message (WindowHandle, 'Conf:' + Conf, 'image', Row1, Col1, 'green', 'false')</l>
<l>endfor</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
