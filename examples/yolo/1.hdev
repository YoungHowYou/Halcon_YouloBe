<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c></c>
<c></c>
<c>* YOLOv8-seg 实例分割示例</c>
<c>* 模型文件位于工程根目录: best.xml</c>
<c></c>
<l>ModelPath := './best.xml'</l>
<l>    Device := 'GPU'</l>
<c></c>
<c>* 加载模型 (字符串值用set_dict_tuple, 对象用set_dict_object)</c>
<l>create_dict (DictHandle)</l>
<l>set_dict_tuple (DictHandle, '工程路径', ModelPath)</l>
<l>set_dict_tuple (DictHandle, '使用设备', Device)</l>
<l>set_dict_tuple (DictHandle, '宽',640)</l>
<l>set_dict_tuple (DictHandle,'高',640)</l>
<l>set_dict_tuple (DictHandle, 'ConfThreshold', 0.25)</l>
<l>set_dict_tuple (DictHandle, 'MaskThreshold', 0.5)</l>
<l>OpenvinoLoadModel (DictHandle, ModelHandle)</l>
<c>* 读取测试图像</c>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="1">* Image Acquisition 01: Code generated by Image Acquisition 01</c>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,2]" as_ord="1">list_files ('F:/Fangbang/YN621B159192W20/8位_带缺陷', ['files','follow_links','recursive'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,3]" as_ord="1">tuple_regexp_select (ImageFiles, ['\\.(tif|tiff|gif|bmp|jpg|jpeg|jp2|png|pcx|pgm|ppm|pbm|xwd|ima|hobj)$','ignore_case'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,2]" as_ord="1">for Index := |ImageFiles| - 1 to 0 by -1</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,3]" as_ord="1">    read_image (Image, ImageFiles[Index])</l>
<l>*     gen_image_const (Image1, 'uint2', 1280, 1280)</l>
<l>*     convert_image_type (Image, Image, 'uint2')</l>
<l>*     add_roi (Image,Image1,  0, 0, 1024, 1024)</l>
<l>*     convert_image_type (Image1, Image, 'byte')</l>
<l>*     zoom_image_size (Image, ImageZoom, 2560, 2560, 'bicubic')</l>
<l>    set_dict_object (Image, DictHandle, 'InputImage')</l>
<l>    gen_empty_obj (EmptyObject)</l>
<l>    set_dict_object (EmptyObject, DictHandle, 'ClassLabelImage')</l>
<l>    set_dict_object (EmptyObject, DictHandle, 'BoundingBoxes')</l>
<c>    </c>
<l>    yolo_seg_detect (ModelHandle, DictHandle)</l>
<c>    </c>
<l>    get_dict_object (binImage, DictHandle, 'ClassLabelImage')</l>
<l>    get_dict_object (BOX, DictHandle, 'BoundingBoxes')</l>
<c>   </c>
<c></c>
<l>    threshold (binImage, Regions, 1, 127)</l>
<c>    </c>
<l>    dev_display (Image)</l>
<l>    dev_display (Regions)</l>
<l>        dev_display (BOX)</l>
<l>stop()</l>
<l>endfor</l>
<l>*     yolo_seg_dectects (ImageZoom, LableImage, DictHandle, ModelHandle)</l>
<c></c>
<c></c>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="yolo_seg_dectects">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="LableImage" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="DictHandle" base_type="ctrl" dimension="0"/>
<par name="ModelHandle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>get_dict_tuple(DictHandle, '宽',W)</l>
<l>get_dict_tuple(DictHandle, '高',H)</l>
<l>get_image_size (Image, Width, Height)</l>
<l>X:=ceil(real(Width)/W)</l>
<l>Y:=ceil(real(Height)/H)</l>
<l>gen_empty_obj (BinImages)</l>
<l>    for RR:=0 to Y-1 by 1</l>
<l>            for CC:=0 to X-1 by 1</l>
<l>                try</l>
<l>                    crop_part (Image, ImagePart, RR*H, CC*H, W, H)</l>
<l>                    set_dict_object (ImagePart, DictHandle, 'InputImage')</l>
<l>                    yolo_seg_detect (ModelHandle, DictHandle)</l>
<l>                    try</l>
<l>                        get_dict_object (binImage, DictHandle, 'ClassLabelImage')</l>
<l>                    catch (Exception)</l>
<l>                        gen_image_const (binImage, 'uint2', W, H)</l>
<l>                    endtry</l>
<l>*                     crop_part (binImage, ImagePart1, 0, 0, W, H)</l>
<l>                    concat_obj (BinImages, binImage, BinImages)</l>
<l>                    remove_dict_key (DictHandle, 'ClassLabelImage')</l>
<l>                catch (Exception)</l>
<l>                endtry</l>
<l>            endfor</l>
<c></c>
<l>    endfor</l>
<l>    tile_images (BinImages, LableImage,ceil(real(Width)/W), 'horizontal')</l>
<l>return ()</l>
</body>
<docu id="yolo_seg_dectects">
<parameters>
<parameter id="DictHandle"/>
<parameter id="Image"/>
<parameter id="LableImage"/>
<parameter id="ModelHandle"/>
</parameters>
</docu>
</procedure>
</hdevelop>
