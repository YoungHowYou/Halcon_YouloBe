<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<l>create_dict (DictHandle)</l>
<l>set_dict_tuple(DictHandle, '工程路径', './best.xml')</l>
<l>set_dict_tuple(DictHandle, '使用设备','GPU')</l>
<l>OpenvinoLoadModel (DictHandle, Handle)</l>
<c></c>
<l>read_image (Image, './52_1.png')</l>
<l>zoom_image_size (Image, Image, 640, 640, 'constant')</l>
<c></c>
<c></c>
<l>OpenVinoInferImage (Image, OutImage, DictHandle, Handle)</l>
<c></c>
<c></c>
<l>threshold (OutImage, Regions, 1, 1)</l>
<c></c>
<l>read_image (Image, './9_17_18_413_130296.png')</l>
<c></c>
<l>dev_get_window (WindowHandle)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="1">* Image Acquisition 01: Code generated by Image Acquisition 01</c>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,2]" as_ord="1">list_files ('C:/Users/young/Desktop/训练集/img_dir', ['files','follow_links','recursive'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,3]" as_ord="1">tuple_regexp_select (ImageFiles, ['\\.(|gif|bmp|jpg|jpeg|jp2|png|pcx|pgm|ppm|pbm|xwd|ima|hobj)$','ignore_case'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,2]" as_ord="1">for Index := 0 to |ImageFiles| - 1 by 1</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,3]" as_ord="1">    read_image (Image, ImageFiles[Index])</l>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,4]" as_ord="1">    * Image Acquisition 01: Do something</c>
<l>    zoom_image_size (Image, ImageZoom, 256, 256, 'constant')</l>
<l>    OpenVinoInferImage (ImageZoom, LableImage, DictHandle, Handle)</l>
<c></c>
<c></c>
<l>threshold (LableImage, Regions, 1, 1)</l>
<l>dev_display (ImageZoom)</l>
<l>dev_display (Regions)</l>
<l>dump_window_image (Image1,WindowHandle)</l>
<l>* write_image (Image1, 'tiff', 0,  ImageFiles[Index])</l>
<l>endfor</l>
<c></c>
<l>zoom_image_size (Image, ImageZoom, 512, 512, 'constant')</l>
<l>OpenVinoInferBigImage (ImageZoom, LableImage, DictHandle, Handle)</l>
<c></c>
<c></c>
<c></c>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="OpenVinoInferBigImage">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="LableImage" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="DictHandle" base_type="ctrl" dimension="0"/>
<par name="Handle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>get_dict_tuple(DictHandle, '宽',W)</l>
<l>get_dict_tuple(DictHandle, '高',H)</l>
<l>get_image_size (Image, Width, Height)</l>
<l>X:=ceil(real(Width)/W)</l>
<l>Y:=ceil(real(Height)/H)</l>
<l>gen_empty_obj (BinImages)</l>
<l>    for RR:=0 to Y-1 by 1</l>
<l>            for CC:=0 to X-1 by 1</l>
<l>                try</l>
<l>                    crop_part (Image, ImagePart, RR*H, CC*H, W, H)</l>
<l>                    set_dict_object (ImagePart, DictHandle, 'InputImage')</l>
<l>                    OpenvinoInfer (Handle, DictHandle)</l>
<l>                    get_dict_object (binImage, DictHandle, 'OutputImage')</l>
<l>*                     crop_part (binImage, ImagePart1, 0, 0, W, H)</l>
<l>                    concat_obj (BinImages, binImage, BinImages)</l>
<l>                    remove_dict_key (DictHandle, 'OutputImage')</l>
<l>                catch (Exception)</l>
<l>                endtry</l>
<l>            endfor</l>
<c></c>
<l>    endfor</l>
<l>    tile_images (BinImages, LableImage,ceil(real(Width)/W), 'horizontal')</l>
<l>return ()</l>
</body>
<docu id="OpenVinoInferBigImage">
<parameters>
<parameter id="DictHandle"/>
<parameter id="Handle"/>
<parameter id="Image"/>
<parameter id="LableImage"/>
</parameters>
</docu>
</procedure>
<procedure name="OpenVinoInferImage">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="OutImage" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="DictHandle" base_type="ctrl" dimension="0"/>
<par name="Handle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>set_dict_object (Image, DictHandle, 'InputImage')</l>
<l>OpenvinoInfer (Handle, DictHandle)</l>
<l>get_dict_object (OutImage, DictHandle, 'OutputImage')</l>
<l>return ()</l>
</body>
<docu id="OpenVinoInferImage">
<parameters>
<parameter id="DictHandle"/>
<parameter id="Handle"/>
<parameter id="Image"/>
<parameter id="OutImage"/>
</parameters>
</docu>
</procedure>
</hdevelop>
