{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "halcon-youlobe",
  "version": "2.0.0",
  "description": "HALCON extension package: OpenVINO YOLO26 inference, OpenCV image processing, EXIF metadata",
  "license": "MIT",
  "dependencies": [
    "opencv4",
    {
      "name": "openvino",
      "default-features": false,
      "features": [
        "auto",
        "auto-batch",
        "cpu",
        "gpu",
        "hetero",
        "ir",
        "npu"
      ]
    },
    {
      "name": "exiv2",
      "features": [
        "png"
      ]
    }
  ]
}
